APP_NAME="Gestión de usuarios"
APP_VERSION=1.0.0
ACCOUNT_EMAIL_DOMAIN=mail.com
FRONTEND_URL=http://localhost:5173
APP_ENV=local
APP_KEY=base64:1wkcR5m11tPRDJkUzyWIZqbYGGJkI1vNINBM9w88T1Y=
APP_DEBUG=true
APP_URL=http://localhost:${BACKEND_PORT:-8000}
API_DOCS_PUBLIC=true

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

SANCTUM_TOKEN_EXPIRATION=120

LOGIN_RATE_LIMIT_DECAY_MINUTES=1
LOGIN_RATE_LIMIT_PER_IDENTIFIER=5
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_MIN_FAILURE_RESPONSE_MS=400
LOGIN_MAX_FAILED_ATTEMPTS=3

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_ISOLATION_LEVEL="READ COMMITTED"

MYSQL_DATABASE="${DB_DATABASE}"
MYSQL_USER="${DB_USERNAME}"
MYSQL_PASSWORD="${DB_PASSWORD}"
MYSQL_ROOT_PASSWORD=root

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

IMPORT_QUEUE_CONNECTION=imports

VITE_API_URL=http://localhost:8000/api
